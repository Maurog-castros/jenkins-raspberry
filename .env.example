# ────────────────────────────────────────────────────────────────────────────────
# Jenkins Agent – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.
# ────────────────────────────────────────────────────────────────────────────────

# URL of the Jenkins master (must be reachable from the Raspberry Pi)
JENKINS_URL=http://your-jenkins-master:8080

# Name of the agent node as configured in Jenkins → Manage Nodes
AGENT_NAME=raspberry-agent

# Secret token from Jenkins → Manage Nodes → <AGENT_NAME> → Agent secret
# Retrieve with: curl -u user:apitoken http://jenkins/computer/<AGENT_NAME>/slave-agent.jnlp
AGENT_SECRET=replace-with-your-agent-secret

# Connection mode: "jnlp" (default) or "ssh"
AGENT_MODE=jnlp

# Java tuning – adjust based on available RAM (default targets ~256 MB heap)
JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseSerialGC -Djava.awt.headless=true
